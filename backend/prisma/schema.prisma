// Prisma Schema for 个人法务工作室管理系统
// Database: MySQL 8.0+
// ORM: Prisma v5.7+
// 设计日期: 2026-07-17
// 定位: 独立法务工作者的一站式业务管理工具

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================================================
// 用户与权限模块 (保留兼容)
// =====================================================

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  realName      String    @map("real_name") @db.VarChar(100)
  email         String?   @unique @db.VarChar(100)
  phone         String?   @db.VarChar(20)
  roleId        Int       @map("role_id")
  department    String?   @db.VarChar(100)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime? @map("last_login_at") @db.DateTime(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  // Relations
  role                  Role              @relation(fields: [roleId], references: [id])
  matters               Matter[]          @relation("MatterAssignee")
  createdMatters        Matter[]          @relation("MatterCreator")
  communications        Communication[]
  tasks                 Task[]
  timeEntries           TimeEntry[]
  createdInvoices       Invoice[]

  @@index([username])
  @@index([email])
  @@index([roleId])
  @@map("users")
}

model Role {
  id          Int       @id @default(autoincrement())
  roleName    String    @unique @map("role_name") @db.VarChar(50)
  description String?   @db.Text
  permissions Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  // Relations
  users User[]

  @@map("roles")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

// =====================================================
// 客户管理模块 (核心新增)
// =====================================================

model Client {
  id          Int         @id @default(autoincrement())
  clientType  ClientType  @map("client_type")
  name        String      @db.VarChar(100) // 个人姓名或企业名称
  shortName   String?     @map("short_name") @db.VarChar(50) // 企业简称

  // 联系信息
  phone       String?     @db.VarChar(20)
  email       String?     @db.VarChar(100)
  wechatId    String?     @map("wechat_id") @db.VarChar(50)
  qq          String?     @db.VarChar(20)
  address     String?     @db.VarChar(255)

  // 个人客户特有
  gender      String?     @db.VarChar(10) // MALE / FEMALE / OTHER
  idNumber    String?     @map("id_number") @db.VarChar(50) // 身份证号
  birthDate   DateTime?   @map("birth_date") @db.Date

  // 企业客户特有
  creditCode  String?     @map("credit_code") @db.VarChar(50) // 统一社会信用代码
  legalRep    String?     @map("legal_rep") @db.VarChar(50) // 法人代表
  industry    String?     @db.VarChar(50)
  scale       String?     @db.VarChar(20) // 企业规模: 微/小/中/大
  website     String?     @db.VarChar(255)

  // 企业对接人信息
  contactName   String?   @map("contact_name") @db.VarChar(50)
  contactTitle  String?   @map("contact_title") @db.VarChar(50)
  contactPhone  String?   @map("contact_phone") @db.VarChar(20)
  contactEmail  String?   @map("contact_email") @db.VarChar(100)
  contactWechat String?   @map("contact_wechat") @db.VarChar(50)

  // 服务配置
  servicePlan  String?   @map("service_plan") @db.VarChar(50) // BASIC / STANDARD / PREMIUM / VIRTUAL_DEPT
  monthlyFee   Decimal?  @map("monthly_fee") @db.Decimal(10, 2)
  serviceStart DateTime? @map("service_start") @db.Date
  serviceEnd   DateTime? @map("service_end") @db.Date

  // 标签与备注
  tags         Json?     // 标签数组 ["VIP", "老客户"]
  notes        String?   @db.Text
  source       String?   @db.VarChar(50) // 客户来源

  // 统计信息（冗余字段，提高查询性能）
  totalMatters Int       @default(0) @map("total_matters")
  totalAmount  Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  lastContactAt DateTime? @map("last_contact_at") @db.DateTime(0)

  status       ClientStatus @default(ACTIVE)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  // Relations
  matters          Matter[]
  communications   Communication[]
  documents        Document[]
  invoices         Invoice[]
  enterpriseConfig EnterpriseConfig?
  timeEntries      TimeEntry[]

  @@index([clientType])
  @@index([name])
  @@index([phone])
  @@index([status])
  @@index([lastContactAt])
  @@map("clients")
}

enum ClientType {
  PERSONAL    // 个人客户
  ENTERPRISE  // 企业客户
}

enum ClientStatus {
  ACTIVE      // 合作中
  INACTIVE    // 暂停
  POTENTIAL   // 潜在客户
  CLOSED      // 已结束
}

// =====================================================
// 业务事项模块 (核心新增，统合原合同/案件/咨询)
// =====================================================

model Matter {
  id          Int         @id @default(autoincrement())
  matterNo    String      @unique @map("matter_no") @db.VarChar(50) // 业务编号
  matterType  MatterType  @map("matter_type")
  title       String      @db.VarChar(255)
  description String?     @db.Text

  // 关联客户
  clientId    Int         @map("client_id")

  // 业务详情
  status      MatterStatus @default(PENDING)
  priority    Priority    @default(MEDIUM)

  // 费用信息
  feeType     FeeType     @map("fee_type")
  feeAmount   Decimal?    @map("fee_amount") @db.Decimal(10, 2)
  hourlyRate  Decimal?    @map("hourly_rate") @db.Decimal(10, 2)
  totalAmount Decimal     @default(0) @map("total_amount") @db.Decimal(10, 2)
  paidAmount  Decimal     @default(0) @map("paid_amount") @db.Decimal(10, 2)

  // 时间安排
  startDate   DateTime?   @map("start_date") @db.Date
  deadline    DateTime?   @db.DateTime(0)
  completedAt DateTime?   @map("completed_at") @db.DateTime(0)

  // 进展
  progress    Int         @default(0) // 0-100
  nextAction  String?     @map("next_action") @db.VarChar(500)

  // 业务特定字段（JSON 存储）
  metadata    Json?       // 不同类型业务的扩展字段

  // 负责人
  assigneeId  Int?        @map("assignee_id")
  createdById Int         @map("created_by_id")

  createdAt   DateTime    @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.DateTime(0)

  // Relations
  client        Client        @relation(fields: [clientId], references: [id])
  assignee      User?         @relation("MatterAssignee", fields: [assigneeId], references: [id])
  createdBy     User          @relation("MatterCreator", fields: [createdById], references: [id])
  tasks         Task[]
  timeline      TimelineEvent[]
  documents     Document[]
  timeEntries   TimeEntry[]
  invoices      Invoice[]
  communications Communication[]

  @@index([clientId])
  @@index([matterType])
  @@index([status])
  @@index([assigneeId])
  @@index([deadline])
  @@index([createdAt])
  @@map("matters")
}

enum MatterType {
  CONSULTATION     // 法律咨询
  CONTRACT_REVIEW  // 合同审查
  CONTRACT_DRAFT   // 合同起草
  CASE_LITIGATION  // 诉讼案件
  CASE_ARBITRATION // 仲裁案件
  CASE_MEDIATION   // 调解案件
  COMPLIANCE       // 合规顾问
  TRAINING         // 法律培训
  DOCUMENT_DRAFT   // 文书代写
  OTHER            // 其他
}

enum MatterStatus {
  PENDING         // 待处理
  IN_PROGRESS     // 进行中
  WAITING_CLIENT  // 等待客户
  REVIEWING       // 内部复核
  COMPLETED       // 已完成
  ARCHIVED        // 已归档
  CANCELLED       // 已取消
}

enum FeeType {
  FIXED         // 固定费用
  HOURLY        // 按小时
  CONTINGENCY   // 风险代理
  MONTHLY       // 包月
  FREE          // 免费
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// =====================================================
// 沟通记录模块 (核心新增)
// =====================================================

model Communication {
  id          Int         @id @default(autoincrement())
  clientId    Int         @map("client_id")
  matterId    Int?        @map("matter_id")
  userId      Int?        @map("user_id") // 处理人

  channel     CommChannel
  direction   Direction

  // 内容
  subject     String?     @db.VarChar(255) // 主题(邮件)
  content     String      @db.Text
  summary     String?     @db.VarChar(500) // AI 摘要

  // 附件
  attachments Json?       // [{name, url, size}]

  // 元数据
  contactName String?     @map("contact_name") @db.VarChar(50) // 对接人
  contactInfo String?     @map("contact_info") @db.VarChar(100) // 联系方式
  contactWechat String?   @map("contact_wechat") @db.VarChar(50) // 对接人微信

  // 外部ID（用于同步追踪）
  externalId  String?     @map("external_id") @db.VarChar(100)
  threadId    String?     @map("thread_id") @db.VarChar(100)

  // 邮件特有字段
  fromAddr    String?     @map("from_addr") @db.VarChar(255)
  toAddrs     Json?       @map("to_addrs") // 收件人数组
  ccAddrs     Json?       @map("cc_addrs")

  // 时间
  sentAt      DateTime    @map("sent_at") @db.DateTime(0)
  readAt      DateTime?   @map("read_at") @db.DateTime(0)
  createdAt   DateTime    @default(now()) @map("created_at") @db.DateTime(0)

  // Relations
  client      Client      @relation(fields: [clientId], references: [id])
  matter      Matter?     @relation(fields: [matterId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([matterId])
  @@index([channel])
  @@index([sentAt])
  @@index([externalId])
  @@map("communications")
}

enum CommChannel {
  WECHAT    // 微信
  EMAIL     // 邮件
  SMS       // 短信
  PHONE     // 电话
  MEETING   // 面谈
  VIDEO     // 视频会议
  SYSTEM    // 系统消息
  OTHER     // 其他
}

enum Direction {
  INBOUND   // 收
  OUTBOUND  // 发
}

// =====================================================
// 时间线事件 (业务事项进展记录)
// =====================================================

model TimelineEvent {
  id          Int       @id @default(autoincrement())
  matterId    Int       @map("matter_id")

  eventType   String    @db.VarChar(50) // STATUS_CHANGE / NOTE / FILE_UPLOAD / COMMUNICATION / SYSTEM
  title       String    @db.VarChar(255)
  description String?   @db.Text

  // 状态变化
  fromStatus  String?   @map("from_status") @db.VarChar(50)
  toStatus    String?   @map("to_status") @db.VarChar(50)

  metadata    Json?

  operatorId  Int?      @map("operator_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  // Relations
  matter      Matter    @relation(fields: [matterId], references: [id])

  @@index([matterId])
  @@index([createdAt])
  @@map("timeline_events")
}

// =====================================================
// 任务清单
// =====================================================

model Task {
  id          Int         @id @default(autoincrement())
  matterId    Int?        @map("matter_id")
  userId      Int         @map("user_id") // 负责人

  title       String      @db.VarChar(255)
  description String?     @db.Text

  status      TaskStatus  @default(TODO)
  priority    Priority    @default(MEDIUM)

  dueDate     DateTime?   @map("due_date") @db.DateTime(0)
  completedAt DateTime?   @map("completed_at") @db.DateTime(0)

  // 提醒
  reminderAt  DateTime?   @map("reminder_at") @db.DateTime(0)
  isReminded  Boolean     @default(false) @map("is_reminded")

  createdAt   DateTime    @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.DateTime(0)

  // Relations
  matter      Matter?     @relation(fields: [matterId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

// =====================================================
// 时间记录 (用于计时收费)
// =====================================================

model TimeEntry {
  id          Int       @id @default(autoincrement())
  matterId    Int       @map("matter_id")
  userId      Int       @map("user_id")
  clientId    Int       @map("client_id") // 冗余便于查询

  description String    @db.VarChar(500)

  startTime   DateTime  @map("start_time") @db.DateTime(0)
  endTime     DateTime? @map("end_time") @db.DateTime(0)
  duration    Int?      // 实际分钟数

  hourlyRate  Decimal   @map("hourly_rate") @db.Decimal(10, 2)
  amount      Decimal?  @db.Decimal(10, 2)

  isBillable  Boolean   @default(true) @map("is_billable")
  isBilled    Boolean   @default(false) @map("is_billed")
  invoiceId   Int?      @map("invoice_id")

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  // Relations
  matter      Matter    @relation(fields: [matterId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  client      Client    @relation(fields: [clientId], references: [id])
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id])

  @@index([matterId])
  @@index([userId])
  @@index([isBilled])
  @@index([startTime])
  @@map("time_entries")
}

// =====================================================
// 发票与收费
// =====================================================

model Invoice {
  id          Int           @id @default(autoincrement())
  invoiceNo   String        @unique @map("invoice_no") @db.VarChar(50)

  clientId    Int           @map("client_id")
  matterId    Int?          @map("matter_id")
  createdById Int           @map("created_by_id")

  // 金额
  subtotal    Decimal       @db.Decimal(10, 2) // 小计
  taxRate     Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2) // 税率 %
  taxAmount   Decimal       @default(0) @map("tax_amount") @db.Decimal(10, 2)
  discount    Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount Decimal       @map("total_amount") @db.Decimal(10, 2)
  paidAmount  Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)

  // 状态
  status      InvoiceStatus @default(DRAFT)

  // 时间
  issueDate   DateTime?     @map("issue_date") @db.Date
  dueDate     DateTime?     @map("due_date") @db.Date
  paidAt      DateTime?     @map("paid_at") @db.DateTime(0)

  // 明细
  items       Json?         // [{name, quantity, unitPrice, amount, timeEntryIds}]

  notes       String?       @db.Text

  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.DateTime(0)

  // Relations
  client      Client        @relation(fields: [clientId], references: [id])
  matter      Matter?       @relation(fields: [matterId], references: [id])
  createdBy   User          @relation(fields: [createdById], references: [id])
  timeEntries TimeEntry[]

  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT     // 草稿
  ISSUED    // 已开具
  SENT      // 已发送
  PARTIAL   // 部分支付
  PAID      // 已支付
  OVERDUE   // 逾期
  CANCELLED // 已取消
}

// =====================================================
// 文档管理
// =====================================================

model Document {
  id          Int       @id @default(autoincrement())
  fileName    String    @map("file_name") @db.VarChar(255)
  originalName String   @map("original_name") @db.VarChar(255)
  filePath    String    @map("file_path") @db.VarChar(500)
  fileSize    Int       @map("file_size")
  mimeType    String    @map("mime_type") @db.VarChar(100)
  fileHash    String?   @map("file_hash") @db.VarChar(64) // SHA256

  // 关联
  clientId    Int?      @map("client_id")
  matterId    Int?      @map("matter_id")
  uploaderId  Int?      @map("uploader_id")

  // 分类
  category    String?   @db.VarChar(50) // CONTRACT / EVIDENCE / DELIVERABLE / TEMPLATE / OTHER
  tags        Json?

  description String?   @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  // Relations
  client      Client?   @relation(fields: [clientId], references: [id])
  matter      Matter?   @relation(fields: [matterId], references: [id])

  @@index([clientId])
  @@index([matterId])
  @@index([category])
  @@map("documents")
}

// =====================================================
// 企业客户专属配置 (虚拟法务部)
// =====================================================

model EnterpriseConfig {
  id            Int       @id @default(autoincrement())
  clientId      Int       @unique @map("client_id")

  // 服务等级
  serviceLevel  String    @map("service_level") @db.VarChar(20) // BASIC / STANDARD / PREMIUM
  responseTime  Int       @map("response_time") // 承诺响应时间(小时)
  monthlyQuota  Int       @map("monthly_quota") // 月度服务次数上限
  usedQuota     Int       @default(0) @map("used_quota") // 本月已用

  // 对接配置 (预留接口)
  oaWebhookUrl  String?   @map("oa_webhook_url") @db.VarChar(500)
  oaApiKey      String?   @map("oa_api_key") @db.VarChar(255)
  oaApiSecret   String?   @map("oa_api_secret") @db.VarChar(255)
  dingtalkToken String?   @map("dingtalk_token") @db.VarChar(255)
  wecomCorpId   String?   @map("wecom_corp_id") @db.VarChar(100)
  wecomAgentId  String?   @map("wecom_agent_id") @db.VarChar(100)
  wecomSecret   String?   @map("wecom_secret") @db.VarChar(255)

  // 企业成员列表
  members       Json?     // [{name, phone, email, role, department}]

  // 品牌定制
  portalTitle   String?   @map("portal_title") @db.VarChar(100)
  portalLogo    String?   @map("portal_logo") @db.VarChar(500)
  portalTheme   String?   @map("portal_theme") @db.VarChar(20)

  // 自定义字段
  customFields  Json?     @map("custom_fields")

  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  // Relations
  client        Client    @relation(fields: [clientId], references: [id])

  @@map("enterprise_configs")
}

// =====================================================
// 系统日志 (审计用)
// =====================================================

model SystemLog {
  id          Int       @id @default(autoincrement())
  userId      Int?      @map("user_id")
  action      String    @db.VarChar(50) // LOGIN / CREATE / UPDATE / DELETE / EXPORT
  resource    String    @db.VarChar(50) // Client / Matter / Invoice
  resourceId  Int?      @map("resource_id")

  method      String?   @db.VarChar(10)
  path        String?   @db.VarChar(255)
  ip          String?   @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.VarChar(500)

  details     Json?
  status      String    @db.VarChar(20) // SUCCESS / FAILED
  errorMsg    String?   @map("error_msg") @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("system_logs")
}
