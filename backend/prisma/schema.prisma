// Prisma Schema for 个人法务工作室管理系统
// Database: SQLite (嵌入式，无需外部服务)
// ORM: Prisma v5.7+
// 设计日期: 2026-07-17
// 定位: 独立法务工作者的一站式业务管理工具

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================
// 用户与权限模块 (保留兼容)
// =====================================================

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  passwordHash  String    @map("password_hash")
  realName      String    @map("real_name")
  email         String?   @unique
  phone         String?
  roleId        Int       @map("role_id")
  department    String?
  status        String   @default("ACTIVE")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  role                  Role              @relation(fields: [roleId], references: [id])
  matters               Matter[]          @relation("MatterAssignee")
  createdMatters        Matter[]          @relation("MatterCreator")
  communications        Communication[]
  tasks                 Task[]
  timeEntries           TimeEntry[]
  createdInvoices       Invoice[]

  @@index([username])
  @@index([email])
  @@index([roleId])
  @@map("users")
}

model Role {
  id          Int       @id @default(autoincrement())
  roleName    String    @unique @map("role_name")
  description String?
  permissions String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  users User[]

  @@map("roles")
}

// =====================================================
// 客户管理模块 (核心新增)
// =====================================================

model Client {
  id          Int         @id @default(autoincrement())
  clientType  String      @map("client_type")
  name        String // 个人姓名或企业名称
  shortName   String?     @map("short_name") // 企业简称

  // 联系信息
  phone       String?
  email       String?
  wechatId    String?     @map("wechat_id")
  qq          String?
  address     String?

  // 个人客户特有
  gender      String? // MALE / FEMALE / OTHER
  idNumber    String?     @map("id_number") // 身份证号
  birthDate   DateTime?   @map("birth_date")

  // 企业客户特有
  creditCode  String?     @map("credit_code") // 统一社会信用代码
  legalRep    String?     @map("legal_rep") // 法人代表
  industry    String?
  scale       String? // 企业规模: 微/小/中/大
  website     String?

  // 企业对接人信息
  contactName   String?   @map("contact_name")
  contactTitle  String?   @map("contact_title")
  contactPhone  String?   @map("contact_phone")
  contactEmail  String?   @map("contact_email")
  contactWechat String?   @map("contact_wechat")

  // 服务配置
  servicePlan  String?   @map("service_plan") // BASIC / STANDARD / PREMIUM / VIRTUAL_DEPT
  monthlyFee   Decimal?  @map("monthly_fee")
  serviceStart DateTime? @map("service_start")
  serviceEnd   DateTime? @map("service_end")

  // 标签与备注
  tags         String?   // 标签数组 ["VIP", "老客户"] (JSON 字符串)
  notes        String?
  source       String? // 客户来源

  // 统计信息（冗余字段，提高查询性能）
  totalMatters Int       @default(0) @map("total_matters")
  totalAmount  Decimal   @default(0) @map("total_amount")
  lastContactAt DateTime? @map("last_contact_at")

  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  matters          Matter[]
  communications   Communication[]
  documents        Document[]
  invoices         Invoice[]
  enterpriseConfig EnterpriseConfig?
  timeEntries      TimeEntry[]

  @@index([clientType])
  @@index([name])
  @@index([phone])
  @@index([status])
  @@index([lastContactAt])
  @@map("clients")
}

// =====================================================
// 业务事项模块 (核心新增，统合原合同/案件/咨询)
// =====================================================

model Matter {
  id          Int         @id @default(autoincrement())
  matterNo    String      @unique @map("matter_no") // 业务编号
  matterType  String      @map("matter_type")
  title       String
  description String?

  // 关联客户
  clientId    Int         @map("client_id")

  // 业务详情
  status      String      @default("PENDING")
  priority    String      @default("MEDIUM")

  // 费用信息
  feeType     String      @map("fee_type")
  feeAmount   Decimal?    @map("fee_amount")
  hourlyRate  Decimal?    @map("hourly_rate")
  totalAmount Decimal     @default(0) @map("total_amount")
  paidAmount  Decimal     @default(0) @map("paid_amount")

  // 时间安排
  startDate   DateTime?   @map("start_date")
  deadline    DateTime?
  completedAt DateTime?   @map("completed_at")

  // 进展
  progress    Int         @default(0) // 0-100
  nextAction  String?     @map("next_action")

  // 业务特定字段（JSON 存储）
  metadata    String?     // 不同类型业务的扩展字段 (JSON 字符串)

  // 负责人
  assigneeId  Int?        @map("assignee_id")
  createdById Int         @map("created_by_id")

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  client        Client        @relation(fields: [clientId], references: [id])
  assignee      User?         @relation("MatterAssignee", fields: [assigneeId], references: [id])
  createdBy     User          @relation("MatterCreator", fields: [createdById], references: [id])
  tasks         Task[]
  timeline      TimelineEvent[]
  documents     Document[]
  timeEntries   TimeEntry[]
  invoices      Invoice[]
  communications Communication[]

  @@index([clientId])
  @@index([matterType])
  @@index([status])
  @@index([assigneeId])
  @@index([deadline])
  @@index([createdAt])
  @@map("matters")
}

// =====================================================
// 沟通记录模块 (核心新增)
// =====================================================

model Communication {
  id          Int         @id @default(autoincrement())
  clientId    Int         @map("client_id")
  matterId    Int?        @map("matter_id")
  userId      Int?        @map("user_id") // 处理人

  channel     String
  direction   String

  // 内容
  subject     String? // 主题(邮件)
  content     String
  summary     String? // AI 摘要

  // 附件
  attachments String?     // [{name, url, size}] (JSON 字符串)

  // 元数据
  contactName String?     @map("contact_name") // 对接人
  contactInfo String?     @map("contact_info") // 联系方式
  contactWechat String?   @map("contact_wechat") // 对接人微信

  // 外部ID（用于同步追踪）
  externalId  String?     @map("external_id")
  threadId    String?     @map("thread_id")

  // 邮件特有字段
  fromAddr    String?     @map("from_addr")
  toAddrs     String?     @map("to_addrs") // 收件人数组 (JSON 字符串)
  ccAddrs     String?     @map("cc_addrs") // 抄送数组 (JSON 字符串)

  // 时间
  sentAt      DateTime    @map("sent_at")
  readAt      DateTime?   @map("read_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  client      Client      @relation(fields: [clientId], references: [id])
  matter      Matter?     @relation(fields: [matterId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([matterId])
  @@index([channel])
  @@index([sentAt])
  @@index([externalId])
  @@map("communications")
}

// =====================================================
// 时间线事件 (业务事项进展记录)
// =====================================================

model TimelineEvent {
  id          Int       @id @default(autoincrement())
  matterId    Int       @map("matter_id")

  eventType   String // STATUS_CHANGE / NOTE / FILE_UPLOAD / COMMUNICATION / SYSTEM
  title       String
  description String?

  // 状态变化
  fromStatus  String?   @map("from_status")
  toStatus    String?   @map("to_status")

  metadata    String?

  operatorId  Int?      @map("operator_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  matter      Matter    @relation(fields: [matterId], references: [id])

  @@index([matterId])
  @@index([createdAt])
  @@map("timeline_events")
}

// =====================================================
// 任务清单
// =====================================================

model Task {
  id          Int         @id @default(autoincrement())
  matterId    Int?        @map("matter_id")
  userId      Int         @map("user_id") // 负责人

  title       String
  description String?

  status      String      @default("TODO")
  priority    String      @default("MEDIUM")

  dueDate     DateTime?   @map("due_date")
  completedAt DateTime?   @map("completed_at")

  // 提醒
  reminderAt  DateTime?   @map("reminder_at")
  isReminded  Boolean     @default(false) @map("is_reminded")

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  matter      Matter?     @relation(fields: [matterId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

// =====================================================
// 时间记录 (用于计时收费)
// =====================================================

model TimeEntry {
  id          Int       @id @default(autoincrement())
  matterId    Int       @map("matter_id")
  userId      Int       @map("user_id")
  clientId    Int       @map("client_id") // 冗余便于查询

  description String

  startTime   DateTime  @map("start_time")
  endTime     DateTime? @map("end_time")
  duration    Int?      // 实际分钟数

  hourlyRate  Decimal   @map("hourly_rate")
  amount      Decimal?

  isBillable  Boolean   @default(true) @map("is_billable")
  isBilled    Boolean   @default(false) @map("is_billed")
  invoiceId   Int?      @map("invoice_id")

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  matter      Matter    @relation(fields: [matterId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  client      Client    @relation(fields: [clientId], references: [id])
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id])

  @@index([matterId])
  @@index([userId])
  @@index([isBilled])
  @@index([startTime])
  @@map("time_entries")
}

// =====================================================
// 发票与收费
// =====================================================

model Invoice {
  id          Int           @id @default(autoincrement())
  invoiceNo   String        @unique @map("invoice_no")

  clientId    Int           @map("client_id")
  matterId    Int?          @map("matter_id")
  createdById Int           @map("created_by_id")

  // 金额
  subtotal    Decimal // 小计
  taxRate     Decimal       @default(0) @map("tax_rate") // 税率 %
  taxAmount   Decimal       @default(0) @map("tax_amount")
  discount    Decimal       @default(0)
  totalAmount Decimal       @map("total_amount")
  paidAmount  Decimal       @default(0) @map("paid_amount")

  // 状态
  status      String        @default("DRAFT")

  // 时间
  issueDate   DateTime?     @map("issue_date")
  dueDate     DateTime?     @map("due_date")
  paidAt      DateTime?     @map("paid_at")

  // 明细
  items       String?       // [{name, quantity, unitPrice, amount, timeEntryIds}] (JSON 字符串)

  notes       String?

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  client      Client        @relation(fields: [clientId], references: [id])
  matter      Matter?       @relation(fields: [matterId], references: [id])
  createdBy   User          @relation(fields: [createdById], references: [id])
  timeEntries TimeEntry[]
  payments    Payment[]

  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

// =====================================================
// 发票付款明细
// =====================================================

model Payment {
  id          Int       @id @default(autoincrement())
  invoiceId   Int       @map("invoice_id")
  amount      Decimal
  paymentDate DateTime  @map("payment_date")
  method      String? // WECHAT/ALIPAY/BANK/CASH/OTHER
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")

  invoice     Invoice   @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("payments")
}

// =====================================================
// 文档管理
// =====================================================

model Document {
  id          Int       @id @default(autoincrement())
  fileName    String    @map("file_name")
  originalName String   @map("original_name")
  filePath    String    @map("file_path")
  fileSize    Int       @map("file_size")
  mimeType    String    @map("mime_type")
  fileHash    String?   @map("file_hash") // SHA256

  // 关联
  clientId    Int?      @map("client_id")
  matterId    Int?      @map("matter_id")
  uploaderId  Int?      @map("uploader_id")

  // 分类
  category    String? // CONTRACT / EVIDENCE / DELIVERABLE / TEMPLATE / OTHER
  tags        String? // (JSON 字符串)

  description String?

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  client      Client?   @relation(fields: [clientId], references: [id])
  matter      Matter?   @relation(fields: [matterId], references: [id])

  @@index([clientId])
  @@index([matterId])
  @@index([category])
  @@map("documents")
}

// =====================================================
// 企业客户专属配置 (虚拟法务部)
// =====================================================

model EnterpriseConfig {
  id            Int       @id @default(autoincrement())
  clientId      Int       @unique @map("client_id")

  // 服务等级
  serviceLevel  String    @map("service_level") // BASIC / STANDARD / PREMIUM
  responseTime  Int       @map("response_time") // 承诺响应时间(小时)
  monthlyQuota  Int       @map("monthly_quota") // 月度服务次数上限
  usedQuota     Int       @default(0) @map("used_quota") // 本月已用

  // 对接配置 (预留接口)
  oaWebhookUrl  String?   @map("oa_webhook_url")
  oaApiKey      String?   @map("oa_api_key")
  oaApiSecret   String?   @map("oa_api_secret")
  dingtalkToken String?   @map("dingtalk_token")
  wecomCorpId   String?   @map("wecom_corp_id")
  wecomAgentId  String?   @map("wecom_agent_id")
  wecomSecret   String?   @map("wecom_secret")

  // 企业成员列表
  members       String?   // [{name, phone, email, role, department}] (JSON 字符串)

  // 品牌定制
  portalTitle   String?   @map("portal_title")
  portalLogo    String?   @map("portal_logo")
  portalTheme   String?   @map("portal_theme")

  // 自定义字段
  customFields  String?   @map("custom_fields") // (JSON 字符串)

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  client        Client    @relation(fields: [clientId], references: [id])

  @@map("enterprise_configs")
}

// =====================================================
// 系统日志 (审计用)
// =====================================================

model SystemLog {
  id          Int       @id @default(autoincrement())
  userId      Int?      @map("user_id")
  action      String // LOGIN / CREATE / UPDATE / DELETE / EXPORT
  resource    String // Client / Matter / Invoice
  resourceId  Int?      @map("resource_id")

  method      String?
  path        String?
  ip          String?
  userAgent   String?   @map("user_agent")

  details     String? // (JSON 字符串)
  status      String // SUCCESS / FAILED
  errorMsg    String?   @map("error_msg")

  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("system_logs")
}
